---
interface Category {
  value: string;
  label: string;
}

interface Props {
  categories: Category[];
  active?: string;
}

const { categories, active = "" } = Astro.props;
---

<div class="blog-filter-bar" data-blog-filter-bar>
  {
    categories.map(({ value, label }) => {
      const isActive = active === value;
      return (
        <a
          href={value ? `/blog?categoria=${value}` : "/blog"}
          data-filter-value={value}
          class={isActive ? "blog-filter-pill blog-filter-pill-active" : "blog-filter-pill"}
        >
          {label}
        </a>
      );
    })
  }
</div>

<script>
  const filterBar = document.querySelector<HTMLElement>("[data-blog-filter-bar]");
  if (filterBar) {
    const pills = Array.from(filterBar.querySelectorAll<HTMLAnchorElement>("[data-filter-value]"));
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-blog-item]"));
    const grid = document.querySelector<HTMLElement>("[data-blog-grid]");
    const emptyState = document.querySelector<HTMLElement>("[data-blog-empty]");

    const applyFilter = (selected: string, pushHistory = false) => {
      let visibleCount = 0;

      pills.forEach((pill) => {
        const val = pill.dataset.filterValue ?? "";
        pill.classList.toggle("blog-filter-pill-active", val === selected);
      });

      items.forEach((item) => {
        const cat = item.dataset.category ?? "";
        const match = !selected || cat === selected;
        item.style.display = match ? "" : "none";
        if (match) visibleCount += 1;
      });

      if (grid) {
        grid.style.display = visibleCount === 0 ? "none" : "grid";
      }
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? "block" : "none";
      }

      if (pushHistory) {
        const nextUrl = selected ? `/blog?categoria=${encodeURIComponent(selected)}` : "/blog";
        window.history.pushState({ categoria: selected }, "", nextUrl);
      }
    };

    const readCategoryFromUrl = () => {
      return new URLSearchParams(window.location.search).get("categoria") ?? "";
    };

    // Sincroniza estado inicial caso a URL já tenha ?categoria=
    const initialCategory = readCategoryFromUrl();
    if (initialCategory) {
      applyFilter(initialCategory, false);
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", (event) => {
        event.preventDefault();
        const value = pill.dataset.filterValue ?? "";
        applyFilter(value, true);
      });
    });

    window.addEventListener("popstate", () => {
      applyFilter(readCategoryFromUrl(), false);
    });
  }
</script>

<style is:global>
  .blog-filter-bar {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: none;
  }

  .blog-filter-bar::-webkit-scrollbar {
    display: none;
  }

  .blog-filter-pill {
    flex-shrink: 0;
    padding: 8px 18px;
    border: 1px solid rgba(199, 199, 191, 0.5);
    border-radius: 9999px;
    background: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    transition:
      background 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .blog-filter-pill-active {
    border: none;
    background: var(--color-secondary);
    color: #fff;
    box-shadow: 0 4px 16px rgba(143, 75, 66, 0.2);
  }
</style>
